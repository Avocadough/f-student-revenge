; Built on SD Studios 3D-lab1 menu flow and Jeh3no third-person movement.
config_version=5

[application]
config/name="การล้างแค้นของนักศึกษาติด F"
config/description="A three-stage campus beat-em-up demo. CP410844 Group 3."
run/main_scene="res://Scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/use_nearest_mipmap_filter.web=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.07, 0.085, 0.11, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=20.0

[filesystem]
import/blender/enabled=false

[debug]
gdscript/warnings/treat_warnings_as_errors=false
